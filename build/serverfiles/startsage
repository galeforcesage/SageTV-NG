#
# Starts the SageTV server process. Works in two modes:
#   1. State-managed container (entrypoint-state.sh): creates .sage-run so
#      the supervisor loop respawns java automatically.
#   2. Traditional (bare metal / non-supervised): launches startsagecore.
#
case $0 in
/*)
   sagepath="$0"
   ;;
*)
   sagepath="$PWD/$0"
   ;;
esac

sagepath=`dirname $sagepath`
echo Changing to SageTV directory $sagepath
cd $sagepath

PIDFILE=/var/run/sagetv.pid
RUNFILE=.sage-run

# You can use the sagesettings file to overwrite settings
if [ -e sagesettings ] ; then
	. sagesettings
fi

# Check if already running
sagepid=$(pgrep -f 'sage\.Sage' 2>/dev/null | head -1)
if [ -n "$sagepid" ]; then
   echo "Already running (pid $sagepid)"
   exit 1
fi

# Detect state-managed container: entrypoint-state.sh is PID 7's script
if ps -p 7 -o cmd= 2>/dev/null | grep -q 'entrypoint-state'; then
   # Supervised mode: just create .sage-run and the supervisor respawns java
   touch "$RUNFILE"
   echo "Created $RUNFILE — supervisor will respawn SageTV"
   exit 0
fi

# Traditional mode: launch startsagecore directly
#NOTE: Linux users should put their license key inside of the
#'activkey' file in the SageTV folder

chmod 777 /var/media/videos 2>/dev/null || true
chmod 777 /var/media/pictures 2>/dev/null || true
chmod 777 /var/media/music 2>/dev/null || true

./startsagecore <&- &
exit 0
